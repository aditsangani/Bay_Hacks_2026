# Copy this file to database/.env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# Use the service_role key here, not the anon key — the backend needs
# to read/write freely without fighting row-level-security policies,
# and the service_role key is only ever used server-side. Never expose
# it to the frontend or commit database/.env (it's already gitignored).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
