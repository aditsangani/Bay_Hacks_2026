# The Vite development server automatically uses local demo accounts when
# frontend/.env is absent or still contains these placeholders. Fill in your
# Supabase project's values to test real authentication instead.
# (Project Settings -> API in the Supabase dashboard.)
#
# Use the anon/public key here, NEVER the service_role key -- this file
# ships to the browser bundle at build time (Vite inlines VITE_-prefixed
# vars), so anything placed here is publicly visible. The anon key is
# safe to expose; Row Level Security policies (see database/schema.sql)
# are what keep direct frontend-to-Supabase access safe.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
